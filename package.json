{
  "name": "manga-reader-tauri",
  "private": true,
  "version": "0.19.1",
  "description": "Moyu - a free desktop application for manga reading and library management.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "tsc --noEmit && cargo check --manifest-path src-tauri/Cargo.toml --all-targets",
    "check:release-surface": "node --experimental-strip-types scripts/release-surface.mjs",
    "test:rust": "cargo test --lib --manifest-path src-tauri/Cargo.toml",
    "test:web": "node --experimental-strip-types --test tests/reader-progress.test.mjs",
    "test:static": "node --experimental-strip-types --test tests/release-surface.test.mjs",
    "test:skin": "node tests/qa/skin-viewport-guard.mjs",
    "format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.67.0",
    "pdfjs-dist": "^6.5.438",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.3.4",
    "shadcn": "^4.23.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.5"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
